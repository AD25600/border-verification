# ─────────────────────────────────────────────────────────────────────────
# Database — Supabase-hosted PostgreSQL
# ─────────────────────────────────────────────────────────────────────────
# Get this from your Supabase project: Project Settings → Database → Connection string
# (choose the "URI" tab). Never commit the real value — this file only holds placeholders.
#
# Supabase gives you two connection options; pick ONE and set DB_USE_PGBOUNCER to match:
#
#   1) Connection pooler (PgBouncer, "Transaction" mode) — recommended for a typical
#      backend with many short-lived requests. Uses port 6543.
#      DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#      DB_USE_PGBOUNCER=true
#
#   2) Direct connection — uses port 5432. Simpler, but Supabase caps direct
#      connections per project, so prefer the pooler above for anything beyond local dev.
#      DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#      DB_USE_PGBOUNCER=false
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres
DB_USE_PGBOUNCER=true

# Supabase requires TLS. Leave as "require" unless connecting to a local/non-SSL database.
DB_SSL_MODE=require

# Only used when DB_USE_PGBOUNCER=false (direct connection pooling handled by SQLAlchemy).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# App
APP_NAME=Border Verification Platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────
# ML Pipeline — file upload handling
# ─────────────────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/border-verification-uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf

# ─────────────────────────────────────────────────────────────────────────
# ML Pipeline — adapter wiring
# ─────────────────────────────────────────────────────────────────────────
# Leave these blank until each teammate's model is ready. See README.md
# "ML Integration" section for exactly what each class must implement.
YOLO_ADAPTER_CLASS=
YOLO_MODEL_PATH=

OCR_ADAPTER_CLASS=
OCR_MODEL_PATH=

MRZ_ADAPTER_CLASS=

TAMPERING_ADAPTER_CLASS=
TAMPERING_MODEL_PATH=

RISK_ADAPTER_CLASS=
RISK_MODEL_PATH=